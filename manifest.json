{
  "manifest_version": 3,
  "name": "מדבקה דיגיטלית — Language Sticker",
  "version": "0.5.13",
  "description": "BETA (test stage). Translates website menus and labels on screen, locally. Nothing leaves your computer unless you send feedback.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "מדבקת שפה",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://docs.google.com"
  },
  "background": {
    "service_worker": "background.js"
  },
  "version_name": "0.5.13 beta — test stage",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "feedback.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}